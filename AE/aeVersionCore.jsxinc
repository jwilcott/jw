// Shared core for AE version up/down scripts.

$.global.AEVersions = (function (existingApi) {
        var MAX_VERSION_JUMPS = 5;
        var api = existingApi || {};

        function isDigit(ch) {
            return ch >= '0' && ch <= '9';
        }

        function isAlphaNum(ch) {
            return (ch >= '0' && ch <= '9') ||
                   (ch >= 'A' && ch <= 'Z') ||
                   (ch >= 'a' && ch <= 'z');
        }

        function findLastVersionToken(name) {
            var last = null;
            var i, j, ch, prev;

            for (i = 0; i < name.length - 1; i++) {
                ch = name.charAt(i);
                if ((ch === 'v' || ch === 'V') && isDigit(name.charAt(i + 1))) {
                    prev = (i === 0) ? '' : name.charAt(i - 1);
                    if (i === 0 || !isAlphaNum(prev)) {
                        j = i + 1;
                        while (j < name.length && isDigit(name.charAt(j))) {
                            j++;
                        }

                        last = {
                            start: i,
                            end: j,
                            letter: ch,
                            digits: name.substring(i + 1, j)
                        };
                    }
                }
            }

            return last;
        }

        function setVersionInName(fileName, token, versionNumber) {
            if (!token) {
                return null;
            }

            var width = token.digits.length;
            var padded = (new Array(width + 1).join('0') + versionNumber).slice(-width);
            var replacement = token.letter + padded;

            return fileName.substring(0, token.start) + replacement + fileName.substring(token.end);
        }

        function parseTrailingNumberToken(fileName) {
            var match = fileName.match(/^(.*?)(\d+)(\.[^\.]+)$/);
            if (!match) {
                return null;
            }

            return {
                prefix: match[1],
                digits: match[2],
                extension: match[3]
            };
        }

        // Cache only for one click so newly rendered files are visible next time.
        function folderRecord(folder, cache) {
            var key = '$' + folder.fsName;
            if (!cache[key]) {
                cache[key] = {
                    exists: folder.exists,
                    exact: {},
                    entries: null,
                    sequences: null,
                    siblings: null
                };
            }
            return cache[key];
        }

        function folderEntries(folder, record) {
            if (record.entries === null) {
                record.entries = folder.getFiles();
            }
            return record.entries;
        }

        function sequenceKey(token) {
            return '$' + token.prefix.toLowerCase() + '|' + token.extension.toLowerCase();
        }

        function findSequenceCandidateInFolder(folder, candidateName, cache) {
            var token = parseTrailingNumberToken(candidateName);
            if (!token) {
                return null;
            }

            var record = folderRecord(folder, cache);
            if (record.sequences === null) {
                record.sequences = {};
                var entries = folderEntries(folder, record);
                for (var i = 0; i < entries.length; i++) {
                    var entry = entries[i];
                    if (!(entry instanceof File)) {
                        continue;
                    }
                    var frameToken = parseTrailingNumberToken(entry.name);
                    if (!frameToken) {
                        continue;
                    }
                    var key = sequenceKey(frameToken);
                    var first = record.sequences[key];
                    // Keep the same first-frame ordering without sorting every frame.
                    if (!first || entry.name.toLowerCase() < first.name.toLowerCase()) {
                        record.sequences[key] = entry;
                    }
                }
            }
            return record.sequences[sequenceKey(token)] || null;
        }

        function findCandidateInFolder(folder, candidateName, allowSequenceFrameMismatch, cache) {
            if (!(folder instanceof Folder)) {
                return null;
            }
            var record = folderRecord(folder, cache);
            if (!record.exists) {
                return null;
            }

            var key = '$' + candidateName;
            if (record.exact[key] === undefined) {
                var exactMatch = new File(folder.fsName + '/' + candidateName);
                record.exact[key] = exactMatch.exists ? exactMatch : null;
            }
            if (record.exact[key]) {
                return record.exact[key];
            }
            return allowSequenceFrameMismatch
                ? findSequenceCandidateInFolder(folder, candidateName, cache)
                : null;
        }

        function findCandidateInParentSiblings(srcFile, candidateName, allowSequenceFrameMismatch, cache) {
            var parentDir = srcFile.parent && srcFile.parent.parent ? srcFile.parent.parent : null;
            if (!parentDir || !(parentDir instanceof Folder)) {
                return null;
            }
            var record = folderRecord(parentDir, cache);
            if (!record.exists) {
                return null;
            }

            if (record.siblings === null) {
                var entries = folderEntries(parentDir, record);
                record.siblings = [];
                for (var i = 0; i < entries.length; i++) {
                    if (entries[i] instanceof Folder) {
                        record.siblings.push(entries[i]);
                    }
                }
                record.siblings.sort(function (a, b) {
                    var an = a.name.toLowerCase();
                    var bn = b.name.toLowerCase();
                    if (an < bn) return -1;
                    if (an > bn) return 1;
                    return 0;
                });
            }

            for (var j = 0; j < record.siblings.length; j++) {
                var folder = record.siblings[j];
                if (folder.fsName === srcFile.parent.fsName) {
                    continue;
                }
                var siblingFile = findCandidateInFolder(folder, candidateName, allowSequenceFrameMismatch, cache);
                if (siblingFile) {
                    return siblingFile;
                }
            }
            return null;
        }

        function findVersionFile(srcFile, direction, allowSequenceFrameMismatch, cache) {
            var token = findLastVersionToken(srcFile.name);
            if (!token) {
                return null;
            }

            var currentVersion = parseInt(token.digits, 10);
            var step;

            for (step = 1; step <= MAX_VERSION_JUMPS; step++) {
                var targetVersion = currentVersion + (step * direction);
                if (targetVersion < 0) {
                    break;
                }

                var candidateName = setVersionInName(srcFile.name, token, targetVersion);

                var sameFolder = findCandidateInFolder(srcFile.parent, candidateName, allowSequenceFrameMismatch, cache);
                if (sameFolder) {
                    return sameFolder;
                }

                var siblingFolderFile = findCandidateInParentSiblings(srcFile, candidateName, allowSequenceFrameMismatch, cache);
                if (siblingFolderFile) {
                    return siblingFolderFile;
                }
            }

            return null;
        }

        function copyColorArray(value) {
            if (!value || value.length === undefined) {
                return null;
            }

            var copy = [];
            for (var i = 0; i < value.length; i++) {
                copy.push(value[i]);
            }
            return copy;
        }

        function snapshotInterpretation(footageItem) {
            var source = null;
            var interpretation = {
                alphaMode: null,
                invertAlpha: null,
                premulColor: null
            };

            try {
                source = footageItem.mainSource;
            } catch (err) {
                source = null;
            }

            if (!source) {
                return interpretation;
            }

            try {
                interpretation.alphaMode = source.alphaMode;
            } catch (alphaErr) {
            }

            try {
                interpretation.invertAlpha = source.invertAlpha;
            } catch (invertErr) {
            }

            try {
                interpretation.premulColor = copyColorArray(source.premulColor);
            } catch (premulErr) {
            }

            return interpretation;
        }

        function restoreInterpretation(footageItem, interpretation) {
            var source = null;

            if (!interpretation) {
                return;
            }

            try {
                source = footageItem.mainSource;
            } catch (err) {
                source = null;
            }

            if (!source) {
                return;
            }

            if (interpretation.alphaMode !== null) {
                try {
                    source.alphaMode = interpretation.alphaMode;
                } catch (alphaErr) {
                }
            }

            if (interpretation.invertAlpha !== null) {
                try {
                    source.invertAlpha = interpretation.invertAlpha;
                } catch (invertErr) {
                }
            }

            if (interpretation.premulColor !== null) {
                try {
                    source.premulColor = interpretation.premulColor;
                } catch (premulErr) {
                }
            }
        }

        function buildReplacementAttempts(newFile) {
            var attempts = [];

            if (!newFile) {
                return attempts;
            }

            attempts.push(newFile);

            try {
                if (newFile.fsName) {
                    attempts.push(new File(newFile.fsName));
                }
            } catch (err) {
            }

            return attempts;
        }

        function replaceFootage(footageItem, newFile) {
            var isStill = true;
            var interpretation = snapshotInterpretation(footageItem);
            var attempts = buildReplacementAttempts(newFile);
            var lastError = null;
            var i;

            try {
                isStill = footageItem.mainSource.isStill;
            } catch (e) {
                isStill = true;
            }

            for (i = 0; i < attempts.length; i++) {
                try {
                    if (!isStill && footageItem.replaceWithSequence) {
                        footageItem.replaceWithSequence(attempts[i], false);
                    } else {
                        footageItem.replace(attempts[i]);
                    }

                    restoreInterpretation(footageItem, interpretation);
                    return;
                } catch (err) {
                    lastError = err;
                }
            }

            if (lastError) {
                throw lastError;
            }
        }

        function collectTargets() {
            var targets = [];
            var seenFootageIds = {};

            if (!app.project) {
                return targets;
            }

            var comp = app.project.activeItem;
            var layers = (comp instanceof CompItem) ? comp.selectedLayers : null;
            var i;

            if (layers && layers.length > 0) {
                for (i = 0; i < layers.length; i++) {
                    var layer = layers[i];
                    if (!(layer instanceof AVLayer) || !layer.source || !(layer.source instanceof FootageItem)) {
                        continue;
                    }

                    var layerFootage = layer.source;
                    if (seenFootageIds[layerFootage.id]) {
                        continue;
                    }
                    seenFootageIds[layerFootage.id] = true;

                    targets.push({
                        name: layer.name,
                        footage: layerFootage
                    });
                }

                return targets;
            }

            var selection = app.project.selection;
            if (!selection || selection.length === 0) {
                return targets;
            }

            for (i = 0; i < selection.length; i++) {
                var item = selection[i];
                if (!(item instanceof FootageItem)) {
                    continue;
                }

                if (seenFootageIds[item.id]) {
                    continue;
                }
                seenFootageIds[item.id] = true;

                targets.push({
                    name: item.name,
                    footage: item
                });
            }

            return targets;
        }

        function buildSummaryMessage(direction, updated, skippedCount) {
            var label = direction === 0 ? 'Reloaded' : (direction > 0 ? 'Versioned up' : 'Versioned down');
            var message = label + ': ' + updated;

            if (skippedCount > 0) {
                message += ' | skipped: ' + skippedCount;
            }

            return message;
        }

        function run(direction, logPrefix) {
            var prefix = logPrefix || 'Version';
            var message = '';
            var statusMessage = '';

            if (!app.project) {
                message = prefix + ': no open project.';
                $.writeln(message);
                return {
                    updated: 0,
                    skipped: [],
                    message: message,
                    reason: 'no_project'
                };
            }

            var targets = collectTargets();
            if (targets.length === 0) {
                message = prefix + ': select timeline layers or Project panel footage items.';
                $.writeln(message);
                return {
                    updated: 0,
                    skipped: [],
                    message: message,
                    reason: 'no_targets'
                };
            }

            var updated = 0;
            var skipped = [];
            var cache = {};
            var groupName = direction === 0 ? 'Reload Selected Sources'
                : (direction > 0 ? 'Version Up Selected Sources' : 'Version Down Selected Sources');

            app.beginUndoGroup(groupName);

            try {
                for (var i = 0; i < targets.length; i++) {
                    var target = targets[i];
                    var footage = target.footage;
                    try {
                        var source = footage.mainSource;
                        if (!source || !source.file) {
                            skipped.push(target.name + ' (no file source)');
                            continue;
                        }

                        if (direction === 0) {
                            source.reload();
                            updated++;
                            continue;
                        }

                        var srcFile = source.file;
                        if (!findLastVersionToken(srcFile.name)) {
                            skipped.push(target.name + ' (no v## token found)');
                            continue;
                        }
                        var allowSequenceFrameMismatch = false;
                        try {
                            allowSequenceFrameMismatch = !source.isStill;
                        } catch (isStillErr) {
                        }

                        var newFile = findVersionFile(srcFile, direction, allowSequenceFrameMismatch, cache);
                        if (!newFile) {
                            skipped.push(target.name + (direction > 0
                                ? ' (next version not found in current/sibling folders)'
                                : ' (previous version not found in current/sibling folders)'));
                            continue;
                        }
                        replaceFootage(footage, newFile);
                        updated++;
                    } catch (err) {
                        skipped.push(target.name + (direction === 0 ? ' (reload failed: ' : ' (version failed: ')
                            + err.toString() + ')');
                    }
                }
            } finally {
                app.endUndoGroup();
            }

            statusMessage = buildSummaryMessage(direction, updated, skipped.length);
            message = statusMessage;
            if (skipped.length) {
                message += '\n\nSkipped:\n- ' + skipped.join('\n- ');
            }

            $.writeln(message);
            return {
                updated: updated,
                skipped: skipped,
                statusMessage: statusMessage,
                message: message,
                reason: updated > 0 ? 'updated' : 'no_matches'
            };
        }

        api.run = run;
        api.reload = function (logPrefix) {
            return run(0, logPrefix || 'Reload');
        };

        return api;
    })($.global.AEVersions);

var AEVersions = $.global.AEVersions;
